---
import ProjectList from "../../../components/ProjectList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t } from "../../../i18n/ui";
import { publishedProjects } from "../../../lib/content";

const locale = "en" as const;
const strings = t(locale);
const projects = await publishedProjects(locale);
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} title={strings.navProjects} description={strings.siteDescription} alternate={`${base}projects/`}>
  <header class="page-header">
    <p class="index-label">{strings.archive} · {String(projects.length).padStart(2, "0")} {strings.projectsCount}</p>
    <h1>Projects<span>.</span></h1>
    <p>Selected works and the stories behind the small systems I build and maintain.</p>
  </header>
  <section class="writing-index" aria-label={strings.projectsSection}>
    <ProjectList projects={projects} locale={locale} />
  </section>
</BaseLayout>
