---
import ArticleList from "../../components/ArticleList.astro";
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";
import { t } from "../../i18n/ui";
import { featuredOrLatest, publishedProjects, publishedWriting } from "../../lib/content";

const locale = "en" as const;
const strings = t(locale);
const writing = await publishedWriting(locale);
const projects = await publishedProjects(locale);
const selectedWriting = featuredOrLatest(writing, 3);
const selectedProjects = featuredOrLatest(projects, 3);
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} alternate={base}>
  <section class="home-hero" aria-labelledby="hero-title">
    <p class="index-label">{strings.heroLabel}</p>
    <h1 id="hero-title">{strings.heroTop}<br /><em>{strings.heroEm}</em></h1>
    <p class="hero-intro">{strings.siteDescription}</p>
    <a class="scroll-cue" href="#selected">{strings.selectedWriting} <span aria-hidden="true">↓</span></a>
  </section>

  <section class="home-writing" id="selected" aria-labelledby="selected-title">
    <div class="section-heading">
      <p class="eyebrow">{strings.selectedWriting}</p>
      <h2 id="selected-title">Ideas worth<br />returning to.</h2>
    </div>
    <ArticleList posts={selectedWriting} locale={locale} />
    <a class="text-link" href={`${base}en/writing/`}>{strings.viewAllWriting} <span>→</span></a>
  </section>

  <section class="home-projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="eyebrow">{strings.selectedProjects}</p>
      <h2 id="projects-title">Small systems<br />in progress.</h2>
    </div>
    <ProjectList projects={selectedProjects} locale={locale} />
    <a class="text-link" href={`${base}en/projects/`}>{strings.viewAllProjects} <span>→</span></a>
  </section>

  <section class="currently" aria-labelledby="currently-title">
    <p class="eyebrow">{strings.currently}</p>
    <h2 id="currently-title">{strings.currentlyNote}</h2>
    <ul>
      {site.currently[locale].map((item) => <li>{item}</li>)}
    </ul>
    <p class="place"><span>{new Date().getFullYear()}</span><span>{site.location}</span></p>
  </section>
</BaseLayout>
