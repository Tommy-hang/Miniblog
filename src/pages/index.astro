---
import ArticleList from "../components/ArticleList.astro";
import ProjectList from "../components/ProjectList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { allProjects, allWriting, featuredEntries } from "../lib/content";

const writing = await allWriting();
const projects = await allProjects();
const selectedWriting = featuredEntries(writing, 3);
const selectedProjects = featuredEntries(projects, 3);
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<BaseLayout locale="en">
  <section class="home-hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Thinking<br /><em>in public.</em></h1>
    <p class="hero-intro">{site.description}</p>
    {
      selectedWriting.length > 0 && (
        <a class="scroll-cue" href="#selected">Selected Writing <span aria-hidden="true">↓</span></a>
      )
    }
  </section>

  {
    selectedWriting.length > 0 && (
      <section class="home-writing" id="selected" aria-labelledby="selected-title">
        <div class="section-heading">
          <p class="eyebrow">Selected Writing</p>
          <h2 id="selected-title">Ideas worth<br />returning to.</h2>
        </div>
        <ArticleList posts={selectedWriting} />
        <a class="text-link" href={`${base}writing/`}>View all writing <span>→</span></a>
      </section>
    )
  }

  {
    selectedProjects.length > 0 && (
      <section class="home-projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="eyebrow">Selected Projects</p>
          <h2 id="projects-title">Small systems<br />in progress.</h2>
        </div>
        <ProjectList projects={selectedProjects} />
        <a class="text-link" href={`${base}projects/`}>View all projects <span>→</span></a>
      </section>
    )
  }

  <section class="currently" aria-labelledby="currently-title">
    <p class="eyebrow">Currently</p>
    <h2 id="currently-title">A short field note.</h2>
    <ul>
      {site.currently.map((item) => <li>{item}</li>)}
    </ul>
    <p class="place"><span>{year}</span><span>{site.location}</span></p>
  </section>
</BaseLayout>
