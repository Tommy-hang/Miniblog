---
import { getCollection } from "astro:content";
import ArticleList from "../components/ArticleList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="hero-title">
    <p class="index-label">Independent notes · Index 01</p>
    <h1 id="hero-title">Thinking<br /><em>in public.</em></h1>
    <p class="hero-intro">{site.description}</p>
    <a class="scroll-cue" href="#selected">Selected writing <span aria-hidden="true">↓</span></a>
  </section>

  <section class="home-writing" id="selected" aria-labelledby="selected-title">
    <div class="section-heading">
      <p class="eyebrow">Selected writing</p>
      <h2 id="selected-title">Ideas worth<br />returning to.</h2>
    </div>
    <ArticleList posts={posts.slice(0, 3)} />
    <a class="text-link" href={`${import.meta.env.BASE_URL}writing/`}>View the complete index <span>→</span></a>
  </section>

  <section class="currently" aria-labelledby="currently-title">
    <p class="eyebrow">Currently</p>
    <h2 id="currently-title">A short field note.</h2>
    <ul>
      {site.currently.map((item) => <li>{item}</li>)}
    </ul>
    <p class="place"><span>{new Date().getFullYear()}</span><span>{site.location}</span></p>
  </section>
</BaseLayout>
