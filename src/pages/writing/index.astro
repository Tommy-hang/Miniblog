---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingArchive from "../../components/WritingArchive.astro";
import { allWriting, groupWritingByYear, tagsInUse } from "../../lib/content";
import { tagSlug } from "../../lib/tags";

const posts = await allWriting();
const groups = groupWritingByYear(posts);
const count = String(posts.length).padStart(2, "0");
const navTags = tagsInUse(posts);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  locale="en"
  title="Writing"
  description="Essays and field notes about building, understanding, and paying closer attention."
>
  <header class="page-header">
    <p class="index-label">Archive · {count} pieces</p>
    <h1>Writing<span>.</span></h1>
    <p>Essays and field notes about building, understanding, and paying closer attention.</p>
  </header>
  <nav class="tag-nav" aria-label="Browse writing by topic">
    <a href={`${base}writing/`} aria-current="page">All</a>
    {navTags.map((name) => <a href={`${base}tags/${tagSlug(name)}/`}>{name}</a>)}
  </nav>
  <section class="writing-index" aria-label="All writing">
    <WritingArchive groups={groups} />
  </section>
</BaseLayout>
