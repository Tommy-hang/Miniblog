---
import ArticleList from "../../components/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/ui";
import { publishedWriting } from "../../lib/content";

const locale = "zh" as const;
const strings = t(locale);
const posts = await publishedWriting(locale);
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} title={strings.navWriting} description={strings.siteDescription} alternate={`${base}en/writing/`}>
  <header class="page-header">
    <p class="index-label">{strings.archive} · {posts.length} {strings.writingCount}</p>
    <h1>文章<span>。</span></h1>
    <p>关于构建、理解与更仔细观看的随笔和现场笔记。</p>
  </header>
  <section class="writing-index" aria-label={strings.writingSection}>
    <ArticleList posts={posts} locale={locale} />
  </section>
</BaseLayout>
