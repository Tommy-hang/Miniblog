---
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allProjects } from "../../lib/content";

const projects = await allProjects();
const count = String(projects.length).padStart(2, "0");
---

<BaseLayout
  locale="en"
  title="Projects"
  description="Selected works and the stories behind the small systems I build and maintain."
>
  <header class="page-header">
    <p class="index-label">Archive · {count} works</p>
    <h1>Projects<span>.</span></h1>
    <p>Selected works and the stories behind the small systems I build and maintain.</p>
  </header>
  <section class="writing-index" aria-label="All projects">
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
