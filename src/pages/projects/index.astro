---
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/ui";
import { publishedProjects } from "../../lib/content";

const locale = "zh" as const;
const strings = t(locale);
const projects = await publishedProjects(locale);
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} title={strings.navProjects} description={strings.siteDescription} alternate={`${base}en/projects/`}>
  <header class="page-header">
    <p class="index-label">{strings.archive} · {projects.length} {strings.projectsCount}</p>
    <h1>项目<span>。</span></h1>
    <p>正在构建与维护的小系统，以及它们背后的故事。</p>
  </header>
  <section class="writing-index" aria-label={strings.projectsSection}>
    <ProjectList projects={projects} locale={locale} />
  </section>
</BaseLayout>
