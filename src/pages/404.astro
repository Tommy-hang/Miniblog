---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";

const strings = t("zh");
---

<BaseLayout locale="zh" title="Not found" description="This page does not exist.">
  <section class="not-found">
    <p class="index-label">{strings.notFoundLabel}</p>
    <h1>这里<br /><em>什么都没有。</em></h1>
    <p>{strings.notFoundBody}</p>
    <a class="text-link" href={import.meta.env.BASE_URL}>{strings.returnHome} <span>→</span></a>
  </section>
</BaseLayout>
