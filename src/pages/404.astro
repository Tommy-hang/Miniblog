---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section class="not-found">
    <p class="index-label">Error · 404</p>
    <h1>Nothing<br /><em>here.</em></h1>
    <p>The page may have moved, or perhaps it never existed.</p>
    <a class="text-link" href={import.meta.env.BASE_URL}>Return home <span>→</span></a>
  </section>
</BaseLayout>
