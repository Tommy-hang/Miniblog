---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site";
import { htmlLang, type Locale } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  /**
   * The language of the page's content. Brand pages (home, archives, about)
   * pass "en" because their interface is English; article and project pages
   * pass the content's own language.
   */
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  /** Path of the published translation, when a real counterpart exists. */
  alternate?: string;
}

const {
  locale = "en",
  title,
  description = site.description,
  image = `${import.meta.env.BASE_URL}social-card.svg`,
  type = "website",
  alternate,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171714" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — 中文`} href={`${base}rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — English`} href={`${base}en/rss.xml`} />
    {alternate && (
      <link rel="alternate" hreflang={htmlLang[locale === "zh" ? "en" : "zh"]} href={new URL(alternate, Astro.site)} />
    )}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-shell">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
