---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { t, type Locale } from "../i18n/ui";
import { formatDate, type ContentEntry } from "../lib/content";

interface Props {
  entry: ContentEntry;
  locale: Locale;
  readingTime: number;
  alternate?: string;
}

const { entry, locale, readingTime, alternate } = Astro.props;
const { title, description, date, tags, updated, cover } = entry.data;
const strings = t(locale);
const kind = entry.collection === "writing" ? "writing" : "projects";
const backHref = `${import.meta.env.BASE_URL}${locale === "en" ? "en/" : ""}${kind}/`;
const backLabel = kind === "writing" ? strings.allWriting : strings.allProjects;
---

<BaseLayout locale={locale} title={title} description={description} type="article" alternate={alternate}>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">
        <span>{kind === "writing" ? (tags[0] ?? strings.essay) : (tags[0] ?? strings.piece)}</span>
        {entry.collection === "projects" && "status" in entry.data && entry.data.status && <span>{entry.data.status}</span>}
        <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        <span>{strings.readingTime(readingTime)}</span>
        {alternate && (
          <a class="translation-link" href={alternate} hreflang={locale === "zh" ? "en" : "zh-CN"} lang={locale === "zh" ? "en" : "zh-CN"}>
            {locale === "zh" ? "EN" : "中文"}
          </a>
        )}
      </p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      {updated && (
        <p class="article-updated">
          {strings.published} {formatDate(date, locale)} · {strings.updated} {formatDate(updated, locale)}
        </p>
      )}
      {cover && <Image class="article-cover" src={cover} alt={title} widths={[960, 1440]} sizes="(min-width: 60rem) 56rem, 100vw" />}
    </header>
    <div class="article-body">
      <slot />
    </div>
    <footer class="article-end">
      <p>{strings.endNote}</p>
      {entry.collection === "projects" && ("repo" in entry.data || "demo" in entry.data) && (
        <span class="article-links">
          {"repo" in entry.data && entry.data.repo && <a href={entry.data.repo}>{strings.visitRepo} ↗</a>}
          {"demo" in entry.data && entry.data.demo && <a href={entry.data.demo}>{strings.visitDemo} ↗</a>}
        </span>
      )}
      <a href={backHref}>{backLabel}</a>
    </footer>
  </article>
</BaseLayout>
