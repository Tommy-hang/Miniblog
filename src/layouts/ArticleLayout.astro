---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import TagLinks from "../components/TagLinks.astro";
import { contentStrings, type Locale } from "../i18n/ui";
import { formatDate, formatMonthYear, type ContentEntry } from "../lib/content";

interface Props {
  entry: ContentEntry;
  locale: Locale;
  readingTime: number;
  alternate?: string;
}

const { entry, locale, readingTime, alternate } = Astro.props;
const { title, description, date, tags, updated, cover } = entry.data;
const strings = contentStrings(locale);
const kind = entry.collection === "writing" ? "writing" : "projects";
const backHref = `${import.meta.env.BASE_URL}${kind}/`;
const backLabel = kind === "writing" ? strings.allWriting : strings.allProjects;
const project = entry.collection === "projects" ? entry.data : undefined;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  image={cover?.src}
  type="article"
  alternate={alternate}
>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">
        <TagLinks tags={tags} fallback={kind === "writing" ? strings.essay : strings.piece} />
        {project?.status && <span>{project.status}</span>}
        <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        <span>{strings.readingTime(readingTime)}</span>
        {alternate && (
          <a
            class="translation-link"
            href={alternate}
            hreflang={locale === "zh" ? "en" : "zh-CN"}
            lang={locale === "zh" ? "en" : "zh-CN"}
          >
            {locale === "zh" ? "EN" : "中文"}
          </a>
        )}
      </p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      {updated && (
        <p class="article-updated">
          {strings.published} {formatDate(date, locale)} · {strings.updated} {formatDate(updated, locale)}
        </p>
      )}
    </header>
    {cover && (
      <div class="article-hero">
        <Image
          class="article-cover"
          src={cover}
          alt={title}
          widths={[960, 1440]}
          sizes="(min-width: 72rem) 72rem, 100vw"
        />
      </div>
    )}
    <div class="article-body">
      <slot />
    </div>
    <footer class="article-end">
      <p class="article-signature">{strings.written} {formatMonthYear(date, locale)}</p>
      <span class="article-links">
        {project?.repo && <a href={project.repo}>{strings.visitRepo} ↗</a>}
        {project?.demo && <a href={project.demo}>{strings.visitDemo} ↗</a>}
        <a href={backHref}>{backLabel}</a>
      </span>
    </footer>
  </article>
</BaseLayout>
