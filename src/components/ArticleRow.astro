---
import TagLinks from "./TagLinks.astro";
import { contentStrings, contentLanguageLabel } from "../i18n/ui";
import { localeOf, slugOf, type ContentEntry } from "../lib/content";

interface Props {
  entry: ContentEntry;
  kind: "writing" | "projects";
  /** Leading column: an index ("01") or an archive day ("22"). */
  leading: string;
  /** Optional date label shown before the language marker. */
  metaDate?: string;
  /** Projects only: show the floating cover preview. */
  preview?: boolean;
}

const { entry, kind, leading, metaDate, preview = false } = Astro.props;
const locale = localeOf(entry);
const base = import.meta.env.BASE_URL;
const href = `${base}${locale === "en" ? "en/" : ""}${kind}/${slugOf(entry)}/`;
const strings = contentStrings(locale);
const fallback = kind === "writing" ? strings.essay : strings.piece;
const project = entry.collection === "projects" ? entry.data : undefined;
const cover = preview ? project?.cover : undefined;
---

{/* The row is not an anchor: tags must be real links, and anchors cannot be
    nested. Instead the title carries a stretched overlay that makes the whole
    row clickable, while the tag links sit above it. */}
<li class="article-row">
  <span class="article-number" aria-hidden="true">{leading}</span>
  <span class="article-copy" lang={locale === "zh" ? "zh-CN" : undefined}>
    <strong><a class="article-title" href={href}>{entry.data.title}</a></strong>
    <span>{entry.data.description}</span>
  </span>
  <span class="article-meta">
    <span>
      <TagLinks tags={entry.data.tags} fallback={fallback} />
      {project?.status && <> · {project.status}</>}
    </span>
    <span>
      {metaDate && <>{metaDate} · </>}
      {contentLanguageLabel[locale]}
    </span>
  </span>
  <span class="article-arrow" aria-hidden="true">↗</span>
  {cover && (
    <img
      class="project-preview"
      src={cover.src}
      alt=""
      width={cover.width}
      height={cover.height}
      loading="lazy"
      aria-hidden="true"
    />
  )}
</li>
