---
import ArticleRow from "./ArticleRow.astro";
import { formatIndexDate, type WritingEntry } from "../lib/content";

interface Props {
  posts: WritingEntry[];
}

const { posts } = Astro.props;
---

<ol class="article-list">
  {posts.map((post, index) => (
    <ArticleRow
      entry={post}
      kind="writing"
      leading={String(index + 1).padStart(2, "0")}
      metaDate={formatIndexDate(post.data.date)}
    />
  ))}
</ol>
