---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"writing">[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { day: "2-digit", month: "short", year: "numeric" })
    .format(date)
    .toUpperCase();
---

<ol class="article-list">
  {posts.map((post, index) => (
    <li>
      <a href={`${base}writing/${post.id}/`}>
        <span class="article-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span class="article-copy">
          <strong>{post.data.title}</strong>
          <span>{post.data.description}</span>
        </span>
        <span class="article-meta">
          <span>{post.data.tags[0] ?? "Essay"}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </span>
        <span class="article-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>
