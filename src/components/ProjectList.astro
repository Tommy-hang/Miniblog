---
import ArticleRow from "./ArticleRow.astro";
import { formatYear, type ProjectEntry } from "../lib/content";

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<ol class="project-list">
  {projects.map((project, index) => (
    <ArticleRow
      entry={project}
      kind="projects"
      leading={String(index + 1).padStart(2, "0")}
      metaDate={formatYear(project.data.date)}
      preview
    />
  ))}
</ol>
