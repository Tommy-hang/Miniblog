---
import { formatYear, slugOf, type ProjectEntry } from "../lib/content";
import type { Locale } from "../i18n/ui";

interface Props {
  projects: ProjectEntry[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = locale === "en" ? `${base}en/` : base;
---

<ol class="project-list">
  {projects.map((project, index) => (
    <li>
      <a href={`${prefix}projects/${slugOf(project)}/`}>
        <span class="article-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span class="article-copy">
          <strong>{project.data.title}</strong>
          <span>{project.data.description}</span>
        </span>
        <span class="article-meta">
          <span>{project.data.tags.join(" / ")}</span>
          {project.data.status && <span>{project.data.status}</span>}
          <time datetime={project.data.date.toISOString()}>{formatYear(project.data.date)}</time>
        </span>
        <span class="article-arrow" aria-hidden="true">↗</span>
        {project.data.cover && (
          <img
            class="project-preview"
            src={project.data.cover.src}
            alt=""
            width={project.data.cover.width}
            height={project.data.cover.height}
            loading="lazy"
            aria-hidden="true"
          />
        )}
      </a>
    </li>
  ))}
</ol>
