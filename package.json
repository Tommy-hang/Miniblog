    "remove": "node scripts/remove-content.mjs",
    "publish": "node scripts/publish-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify": "npm run validate:content && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
